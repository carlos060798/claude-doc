# API Configuration
PORT=3000
NODE_ENV=development

# Anthropic API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:8000

# Agent Configuration
EVALUATOR_TIMEOUT_MS=2500
CACHE_TTL_HOURS=24
CACHE_HIT_TARGET_PERCENT=40
